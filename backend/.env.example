# Aplicacao
APP_NAME=VFitness API
ENVIRONMENT=development
DEBUG=true

# PostgreSQL local
DATABASE_URL=postgresql+psycopg2://vfitness:vfitness@localhost:5432/vfitness
# Producao/Supabase: use a connection string completa do Postgres, nao apenas
# a URL do projeto Supabase. Exemplo:
# DATABASE_URL=postgresql://postgres:<senha>@db.qcjhtkiohtmmvpnjcvvw.supabase.co:5432/postgres?sslmode=require

# JWT, substitua por um valor longo e aleatorio fora do desenvolvimento
SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth, preencher apenas quando o login com Google for configurado
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Lista em formato JSON, aceita pelo pydantic-settings
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://vfitness-frontend.vercel.app"]
